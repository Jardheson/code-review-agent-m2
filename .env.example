NODE_ENV=development
PORT=3000

OPENAI_API_KEY=__SUA_CHAVE_OPENAI_AQUI__
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

LOG_LEVEL=info
LOG_FILE=./logs/app.log

MEMORY_STORAGE_PATH=./data/memory.json
AUDIT_LOG_PATH=./data/audit.log

MAX_TOOL_RETRIES=2
MAX_GRAPH_STEPS=15
HUMAN_APPROVAL_REQUIRED=true

ALLOWED_FILE_EXTENSIONS=.ts,.js,.tsx,.jsx,.py,.java,.go
MAX_DIFF_SIZE_BYTES=5242880
WEBHOOK_URL=
