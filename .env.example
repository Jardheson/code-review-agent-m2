NODE_ENV=development
PORT=3000

LLM_PROVIDER=gemini
OPENAI_API_KEY=__SUA_CHAVE_OPENAI_AQUI__
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=__SUA_CHAVE_GOOGLE_GEMINI_AQUI__
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_API_VERSION=v1beta
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

LOG_LEVEL=info
LOG_FILE=./logs/app.log

MEMORY_STORAGE_PATH=./data/memory.json
AUDIT_LOG_PATH=./data/audit.log

STATIC_ANALYSIS_API_URL=

MAX_TOOL_RETRIES=2
MAX_GRAPH_STEPS=15
HUMAN_APPROVAL_REQUIRED=true

ALLOWED_FILE_EXTENSIONS=.ts,.js,.tsx,.jsx,.py,.java,.go
MAX_DIFF_SIZE_BYTES=5242880
WEBHOOK_URL=
